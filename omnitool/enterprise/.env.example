# ==============================================================================
# Omnitool Enterprise Configuration
# Copy this file to .env and fill in your values
# ==============================================================================

# --- Gemma 4 Model ---
# The model endpoint (OpenAI-compatible). Can be vLLM, Ollama, TGI, etc.
GEMMA_BASE_URL=http://localhost:8080/v1
GEMMA_API_KEY=not-needed
GEMMA_MODEL=gemma-4
GEMMA_TEMPERATURE=0.3
GEMMA_MAX_TOKENS=4096

# --- Slack ---
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_SIGNING_SECRET=your-signing-secret

# --- Azure ---
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# --- ServiceNow ---
SNOW_INSTANCE_URL=https://your-instance.service-now.com
SNOW_USERNAME=
SNOW_PASSWORD=

# --- Email ---
EMAIL_SMTP_SERVER=smtp.office365.com
EMAIL_SMTP_PORT=587
EMAIL_IMAP_SERVER=outlook.office365.com
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- OmniParser ---
OMNIPARSER_SERVER_URL=http://localhost:8000

# --- Host Control ---
HOST_CONTROL_URL=http://localhost:5000

# --- Memory ---
MEMORY_DB_PATH=omnitool_memory.db
MEMORY_MAX_CONTEXT_TURNS=20

# --- System ---
APPROVAL_TIMEOUT_SECONDS=300
OMNITOOL_DEBUG=false
